root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Два пробела в конце строки иногда нужны для переноса в Markdown.
trim_trailing_whitespace = false

[*.{json,yml,yaml,js}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4

[*.{png,jpg,jpeg,pdf,docx,xlsx,zip}]
insert_final_newline = false
